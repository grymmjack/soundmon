servers.json

__pycache__/
*.pyc

# generated audio
*.wav
*.flac
*.mp3
*.opus

# Nuked OPL3 is fetched and built by ./download-models.sh --opl.
# It is LGPL-2.1 and this repo is MIT, so the source and the compiled library
# stay OUT of git rather than being silently relicensed. Same reason the models
# are not in here.
vendor/

# Mined from a local MIDI collection by tools/mine-corpus.py. Machine-specific
# (it names a path on disk) and regenerable in minutes, so it stays out of git.
corpus.json
vendor/opl-calibration.json
