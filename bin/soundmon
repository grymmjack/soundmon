#!/usr/bin/env bash
# soundmon — one-command sound-effect generator.
# Makes sure the ComfyUI server is up, then hands your description to soundmon.py.
set -euo pipefail

COMFY="$HOME/ComfyUI"
PY="$COMFY/.venv/bin/python"
URL="http://127.0.0.1:8188"

up() { curl -fsS "$URL/system_stats" >/dev/null 2>&1; }

# Help, listings and the CPU-only engines don't touch the GPU — never start the
# server. --narrate runs Kokoro in-process and --record is a microphone and a
# terminal; neither has anything for ComfyUI to do, so waiting up to 90s for it
# (or failing outright on a box that has no ComfyUI at all) is pure obstruction.
needs_server=1
case " $* " in
    *" -h "*|*" --help "* \
    |*" --list-formats "*|*" --list-styles "*|*" --list-keys "* \
    |*" --list-voices "*|*" --list-devices "* \
    |*" --narrate "*|*" --narrate-file "* \
    |*" --blip "*|*" --blip-file "* \
    |*" --record "*|*" --record-file "*) needs_server=0 ;;
esac
[ "$#" -eq 0 ] && needs_server=0

# A remote render target (--server NAME|HOST, or $SOUNDMON_SERVER) is managed elsewhere
# (e.g. another box on the LAN) — don't try to start a local ComfyUI for it.
TARGET="${SOUNDMON_SERVER:-}"
prev=""
for arg in "$@"; do
    [ "$prev" = "--server" ] && TARGET="$arg"
    prev="$arg"
done
if [ -n "$TARGET" ]; then
    case "$TARGET" in
        local|localhost|127.0.0.1*|http://127.0.0.1*|http://localhost*) ;;
        *) needs_server=0 ;;
    esac
fi

if [ "$needs_server" = 1 ] && ! up; then
    echo "[soundmon] ComfyUI server isn't running — starting it (first run ~15s)..."
    # --force-fp32 is REQUIRED for Stable Audio 3. ComfyUI defaults audio models
    # to fp16 (StableAudio3 declares no supported_inference_dtypes), and fp16
    # inference produces noise and buzzing instead of audio. Verified by ear.
    #
    # It is NOT free: fp32 roughly doubles VRAM and halves throughput, which
    # matters for pixelmon's SDXL on the same shared ComfyUI. So it is applied
    # only when soundmon starts the server itself. If ComfyUI is already running
    # for pixelmon, restart it with --force-fp32 before generating audio.
    nohup "$HOME/launch-comfyui.sh" --force-fp32 >"$COMFY/server.log" 2>&1 &
    for _ in $(seq 1 90); do
        up && break
        sleep 1
    done
    if ! up; then
        echo "[soundmon] server didn't come up. Check $COMFY/server.log" >&2
        exit 1
    fi
    echo "[soundmon] server ready."
fi

exec "$PY" "$COMFY/soundmon.py" "$@"
